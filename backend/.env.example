# ==========================================
# e-Maanak Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Database Connection URL:
# For Localhost Demo: SQLite
DATABASE_URL="file:./dev.db"

# For Production Cloud (PostgreSQL / Supabase):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public&sslmode=require"

# JWT Secret for RBAC authentication (Use minimum 32 random characters in production)
JWT_SECRET=production-grade-sih-2026-sovereign-metrology-secret-key

# Supabase Auth Server Configuration (Backend-Only, NEVER expose to frontend)
SUPABASE_URL=https://pmvwmiyuqroeqypxadto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://emaanak.gov.in,http://localhost:5173,http://localhost:3000

# Base URL for public QR verification URLs generated on certificates
PUBLIC_VERIFY_BASE_URL=https://emaanak.gov.in/verify
